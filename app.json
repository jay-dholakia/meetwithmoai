{
  "expo": {
    "name": "Convi",
    "slug": "convi-connections",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.convi.connections",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Convi uses your location to find local connections nearby.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Convi uses your location to find local connections nearby."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9FA"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.convi.connections",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Convi to use your location to find local connections nearby."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Convi to access your photos to set your profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4dcf5136-0a12-42d2-8e59-b925620b2cdf"
      }
    }
  }
}
